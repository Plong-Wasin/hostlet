# Copy to .env and fill in. Never commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 32+ characters. Changing it logs everyone out.
SESSION_SECRET=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_ID=
# Base domain, e.g. example.com. Hostnames become <subdomain>.example.com
DOMAIN=
# Origin every new Ingress Rule points at, e.g. http://traefik:80
SERVICE_URL=
# Optional
# PORT=3000
# CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
